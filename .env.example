# Copy to .env (git-ignored). scripts/*.cmd and docker-compose load it; the jar itself reads real env vars.
#
# Default authentication is Sign in with ChatGPT: no key needed. Leave OPENAI_AUTH_MODE unset.
# Requests then use your ChatGPT plan; the app never falls back to API-key billing.

# OPENAI_AUTH_MODE=chatgpt

# --- developer/testing mode only (pay-per-use with your own API key) ---
# OPENAI_AUTH_MODE=api-key
# OPENAI_API_KEY=sk-...

# Preferred models. With Sign in with ChatGPT the available list is discovered from the account and
# these are only defaults; pick the actual model in Settings.
OPENAI_COUNSELING_MODEL=gpt-6.1-sol
OPENAI_UTILITY_MODEL=gpt-6-luna
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Reasoning effort: low | medium | high
OPENAI_COUNSELING_REASONING=medium
OPENAI_UTILITY_REASONING=low

# Where SQLite, Markdown and encrypted credentials live (default: ./data via the scripts, /data in Docker)
# MENTALCARE_DATA_DIR=C:/Users/me/mentalcare-data
# MENTALCARE_CREDENTIALS_DIR=C:/Users/me/mentalcare-data/credentials

# Base URL the browser uses to reach the app; the OAuth redirect_uri is derived from it (must be 127.0.0.1).
# MENTALCARE_PUBLIC_URL=http://127.0.0.1:8080

# Host header allow-list. Only change this if you deliberately expose the app beyond this PC.
# MENTALCARE_ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
